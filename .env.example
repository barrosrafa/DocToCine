# Credenciais e Endpoint OpenRouter (nunca versionar chave real)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://github.com/doctocine/lcbooks
OPENROUTER_APP_TITLE=DocToCine Pipeline

# Modelos de Texto por Tarefa
OPENROUTER_SUMMARY_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_SCRIPT_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_STORYBOARD_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,liquid/lfm-2.5-2.6b:free,openrouter/free
OPENROUTER_TEXT_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,liquid/lfm-2.5-2.6b:free,openrouter/free
OPENROUTER_TIMEOUT_MS=45000
LLM_CONCURRENCY=3
MAX_RETRY_ATTEMPTS=3

# Geração de Imagens e Densidade Visual
SCENE_PROVIDER=openrouter
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
SCENE_FALLBACK_PROVIDER=sharp
SCENE_CONCURRENCY=2
SCENE_CACHE_ENABLED=true
VISUAL_SHOT_TARGET_SECONDS=8
AI_IMAGE_MIN_INTERVAL_SECONDS=18
MAX_GENERATED_IMAGES_PER_VIDEO=80

# Síntese de Voz (TTS)
TTS_PROVIDER=openrouter
TTS_LANGUAGE=pt-BR
TTS_VOICE=nova
TTS_SPEAKING_RATE=1
OPENROUTER_AUDIO_MODEL=openai/gpt-audio-mini
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=nova
OPENROUTER_TTS_FALLBACK_MODEL=hexgrad/kokoro-82m
OPENROUTER_TTS_FALLBACK_VOICE=
OPENROUTER_TTS_SPEED=1.0
OPENROUTER_TTS_FORMAT=mp3
TTS_MAX_CHARS_PER_REQUEST=1800
TTS_MAX_PARALLEL_REQUESTS=2
TTS_ALLOW_SYNTHETIC_FIXTURE=false

# Alinhamento e Legendas
ENABLE_WORD_ALIGNMENT=true
ALIGNMENT_PROVIDER=whisperx
BURN_CAPTIONS=true
CAPTION_FONT_NAME=Arial

# Metas de Roteiro e Vídeo
TARGET_WORDS_PER_MINUTE=135
SCRIPT_DURATION_TOLERANCE_PERCENT=8
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_CRF=20
VIDEO_PRESET=medium

# Limites de PDF e Orçamento
MAX_PDF_MB=100
MAX_PDF_PAGES=1000
MAX_CHAPTER_CHARS_PER_CHUNK=12000
CHAPTER_CHUNK_OVERLAP_CHARS=600
MAX_JOB_COST_USD=5
COST_LIMIT_ACTION=stop
